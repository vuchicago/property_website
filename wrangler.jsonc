{
        "name": "cookcountytaxcomparev2",
        "compatibility_date": "2026-02-01",
        "pages_build_output_dir": "dist",
        "vars": {
                "INSURANCE_NOTIFICATION_EMAIL": "vnguyen1@amfam.com",
                "CLOUDFLARE_DEEPSEEK_MODEL": "deepseek/deepseek-v4-flash",
                "CLOUDFLARE_DEEPSEEK_TURN_MODEL": "deepseek/deepseek-v4-flash",
                "DEEPSEEK_MODEL": "deepseek-v4-flash",
                "AI_SALES_TRANSCRIBE_MODEL": "@cf/openai/whisper",
                "AI_SALES_FLUX_MODEL": "@cf/deepgram/flux",
                "AI_SALES_TTS_MODEL": "@cf/deepgram/aura-2-en",
                "AI_SALES_TTS_SPEAKER": "apollo",
                "AI_SALES_WORKERS_MODEL": "@cf/deepseek-ai/deepseek-r1-distill-qwen-32b"
        },
        "d1_databases": [
                {
                        "binding": "DB",
                        "database_name": "appeal_db",
                        "database_id": "ccbba211-1c8b-46b6-94f5-12e1cf840609"
                }
        ],
        "ai": {
                "binding": "AI"
        },
        "observability": {
                "enabled": true
        }
}
